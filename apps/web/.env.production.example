# Production env for Firebase Hosting build (Vite reads VITE_* at build time).
# Copy to apps/web/.env.production and fill in real values before `npm run build`.
#
# DO NOT commit the populated .env.production — these values are baked into
# the JS bundle and shipped to every visitor. The Firebase web config keys
# (apiKey, etc.) are designed to be public and safe to expose.

# Cloud Run API URL — output of `gcloud run services describe killcont-api`
VITE_API_BASE_URL=https://killcont-api-xxxxxxxxxx.a.run.app/api/v1

# Auth profile
VITE_AUTH_MODE=firebase

# Firebase web app config (Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=killcont-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=killcont-demo
VITE_FIREBASE_STORAGE_BUCKET=killcont-demo-media
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — Google Maps key for the threat map. Leave blank to use the
# offline SVG fallback (works without quota).
VITE_GOOGLE_MAPS_API_KEY=
