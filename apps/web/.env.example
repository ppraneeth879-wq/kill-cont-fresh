# Frontend env template (Vite reads VITE_* at build time).
# Copy to apps/web/.env and fill in real values for local dev.

# API base URL. Local default; flip to https://<cloud-run>.a.run.app/api/v1 in production.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Auth mode: demo or firebase
# Demo: shows email+name form, posts to /session/login as a demo bearer token.
# Firebase: shows "Continue with Google" button. Requires the 6 VITE_FIREBASE_*
# vars below to be populated AND the matching backend setup. See
# infra/google-cloud/SETUP.md for the full walkthrough.
VITE_AUTH_MODE=demo

# Firebase web config (Firebase Console -> Project settings -> Your apps -> Web).
# These keys are public by design — Firebase docs explicitly say it's safe to
# ship them in a JS bundle. Real security is enforced via Firestore/Storage
# rules and the backend's ID-token verification.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps key (optional; threat map degrades to SVG placeholder when empty).
VITE_GOOGLE_MAPS_API_KEY=
