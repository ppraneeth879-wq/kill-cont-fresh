APP_NAME=KillCont API
APP_ENV=development
APP_VERSION=0.1.0

# Runtime profile: local or public
RUNTIME_PROFILE=local

# Auth backend: demo or firebase
AUTH_BACKEND=demo

# Backend adapter targets
METADATA_BACKEND=sqlite
MEDIA_BACKEND=local

# Local storage paths (used in local profile)
DB_PATH=var/app.db
MEDIA_DIR=var/media

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_ORIGIN=

# Matching thresholds
#   PHASH_MATCH_THRESHOLD     - asset vs feed_item (repost/derivative detection)
#   PHASH_DUPLICATE_THRESHOLD - asset vs asset (re-registration of the same image)
PHASH_MATCH_THRESHOLD=0.80
PHASH_DUPLICATE_THRESHOLD=0.92

# Triage
GEMINI_API_KEY=

# Demo defaults
DEMO_ORG_ID=org-demo-1
DEMO_DEFAULT_USER_ID=demo-user-1

# Cloud target settings (used for public profile migration)
GCP_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_PATH=
VERTEX_LOCATION=us-central1
